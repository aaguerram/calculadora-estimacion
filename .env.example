# --- Postgres (solo para el entorno local de docker compose) ---------------
POSTGRES_DB=calculadora
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev
POSTGRES_PORT=5432

# Clave del rol de conexion que usa PostgREST.
# En produccion sale de la boveda corporativa, NO de este archivo.
AUTHENTICATOR_PASSWORD=authenticator_dev

# --- PostgREST -------------------------------------------------------------
# Apunta al Postgres on-prem cambiando solo esta linea.
PGRST_DB_URI=postgres://authenticator:authenticator_dev@db:5432/calculadora
PGRST_DB_SCHEMAS=estimacion,benchmark
PGRST_DB_ANON_ROLE=web_anon
# Si el puerto ya esta ocupado en tu maquina, cambialo aqui y en VITE_POSTGREST_URL.
PGRST_PORT=3000

# Secreto HS256 del JWT. MINIMO 32 caracteres.
# En produccion: usa la clave publica del IdP corporativo (RS256) en vez de esto.
PGRST_JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres

# --- Front -----------------------------------------------------------------
# Token precargado en React. Lo genera `npm run token:env`.
#
# ATENCION: cualquier VITE_* queda HORNEADA en el bundle y es publica.
# Esto vale SOLO para desarrollo local. El codigo la ignora en build de
# produccion (`import.meta.env.DEV`), donde el token lo pone el OIDC corporativo.
VITE_POSTGREST_TOKEN=
WEB_PORT=5173
SWAGGER_PORT=8080
# El navegador llama a /api, que Vite (o nginx) redirige a PostgREST.
VITE_POSTGREST_URL=/api
# URL absoluta de PostgREST. La usan los scripts y los tests de integracion,
# que corren en Node y no pueden resolver una ruta relativa.
VITE_POSTGREST_URL_ABSOLUTA=http://localhost:3001
