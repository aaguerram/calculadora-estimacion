# Adjuntos de correo con datos internos de Produbanco (volcados de Azure
# DevOps). No entran nunca al control de versiones: el repositorio es publico.
gmail/

# Datos de referencia: no se versionan.
# Los datasets de terceros no declaran licencia de redistribucion y el
# analisis local puede contener datos internos (p. ej. azure-estructura.json),
# asi que la carpeta entera queda fuera del repositorio publico.
# Se regeneran con: npm run benchmark:descargar
datasets/

# Salida del MCP de Playwright (snapshots y capturas de sesion)
.playwright-mcp/
