{
  "name": "calculadora",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "lint:fsd": "steiger ./src",
    "check": "npm run lint && npm run lint:fsd && tsc -b && npm run test",
    "token": "node scripts/dev-token.mjs",
    "stack:up": "npm run token:env && docker compose up -d --build",
    "stack:down": "docker compose down",
    "stack:reset": "docker compose down -v && npm run token:env && docker compose up -d --build",
    "stack:logs": "docker compose logs -f",
    "test": "vitest run",
    "test:watch": "vitest",
    "token:env": "node scripts/dev-token.mjs --write",
    "seed": "node scripts/seed-alcance.mjs",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "seed:all": "npm run seed && npm run benchmark:cargar",
    "benchmark:cargar": "node scripts/cargar-benchmark.mjs"
  },
  "dependencies": {
    "@carbon/react": "^1.116.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "oxlint": "^1.81.0",
    "sass-embedded": "^1.104.1",
    "steiger": "^0.6.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
